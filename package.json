{
  "name": "strata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal knowledge base where agent-written notes pass a review gate: kb CLI, local service and review web app.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "npm run build:web && node --experimental-strip-types apps/service/src/main.ts",
    "serve": "node --experimental-strip-types apps/service/src/main.ts",
    "dev": "node --experimental-strip-types --watch apps/service/src/main.ts",
    "dev:web": "vite apps/web",
    "build:web": "vite build apps/web",
    "test": "npm run test:node && npm run test:web && npm run test:python",
    "test:node": "node --experimental-strip-types --test \"apps/service/src/*.test.ts\"",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "test:python": "node scripts/run-python-tests.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.201",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "noto-serif-sc": "^31.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
